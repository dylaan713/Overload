{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["node", "vite/client"],
    "jsx": "react-jsx"
  },
  "include": ["src/domain", "src/data", "src/dev", "src/ui", "src/state", "src/app", "src/features", "src/next", "tests"]
}
